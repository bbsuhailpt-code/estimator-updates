{
  "name": "Estimator",
  "short_name": "Estimator",
  "description": "Quantity takeoff from DWG, DXF and PDF drawings.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#15171a",
  "theme_color": "#15171a",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "file_handlers": [{ "action": "./", "accept": { "application/octet-stream": [".estproj"] } }]
}
